      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:9px 15px;border:1px solid var(--line,#dce5df);border-radius:8px;font-family:var(--font,Manrope,Arial,sans-serif);font-size:12px;font-weight:700;line-height:1.6;cursor:pointer;white-space:nowrap;transition:background .16s,border-color .16s;background:var(--accent,#176448);color:#fff;border-color:var(--accent,#176448);}.ds-button-primary:not(:disabled):hover{background:var(--accent-hover,#104d36);border-color:var(--accent-hover,#104d36);}.ds-button-primary:focus-visible{outline:3px solid var(--accent,#176448);outline-offset:4px;}.ds-button-primary:disabled{opacity:.45;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
