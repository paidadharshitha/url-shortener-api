      "html": "<label class=\"ds-field-label\" for=\"ds-destination\">Destination URL</label><input class=\"ds-field\" id=\"ds-destination\" type=\"url\" placeholder=\"https://example.com/your-long-link\">",
      "css": ".ds-field-label{display:block;margin-bottom:7px;font-family:var(--font,Manrope,Arial,sans-serif);font-size:11px;font-weight:700;line-height:1.6;color:var(--ink,#1d3028);}.ds-field{width:100%;min-height:42px;padding:10px 12px;border:1px solid #cedbd3;border-radius:7px;background:#fff;color:var(--ink,#1d3028);font-family:var(--font,Manrope,Arial,sans-serif);font-size:12px;line-height:1.6;caret-color:var(--accent,#176448);}.ds-field::placeholder{color:var(--muted,#62716a);opacity:1;}.ds-field:focus{border-color:var(--accent,#176448);}.ds-field:focus-visible{outline:3px solid var(--accent,#176448);outline-offset:4px;}"
    },
    {
      "name": "Notebook Navigation",
      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "A compact index with tinted current-page treatment.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Preview navigation\"><a class=\"ds-nav-item ds-current\" href=\"#links\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M10 13a5 5 0 0 0 7 .7l3-3a5 5 0 0 0-7-7l-1.7 1.7M14 11a5 5 0 0 0-7-.7l-3 3a5 5 0 0 0 7 7l1.7-1.7\"/></svg>Your links</a><a class=\"ds-nav-item\" href=\"#activity\">Activity</a></nav>",
      "css": ".ds-nav{display:grid;gap:7px;}.ds-nav-item{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:8px;color:var(--muted,#62716a);text-decoration:none;font-family:var(--font,Manrope,Arial,sans-serif);font-size:13px;font-weight:600;line-height:1.6;white-space:nowrap;}.ds-nav-item:hover{background:var(--canvas,#f5f8f6);color:var(--ink,#1d3028);}.ds-nav-item.ds-current{background:var(--accent-soft,#e8f3ec);color:var(--accent,#176448);}.ds-nav-item:focus-visible{outline:3px solid var(--accent,#176448);outline-offset:4px;}.ds-nav-item svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;}"
    },
